# Redis connection (Solana data stream)
REDIS_HOST=192.168.100.2
REDIS_PORT=6379

# Max compute units per block (raise when the network limit changes)
BLOCK_CU_LIMIT=60000000

# WebSocket server port
WS_PORT=3847

# Trade batching interval (ms)
BATCH_INTERVAL=50

# CORS origins (comma-separated, or '*' for all)
CORS_ORIGINS=https://compass.com,https://live.compass.com

# Alpenglow consensus events (validatormetrics fd:monitor-all), Redis on the same box
ALPENGLOW_REDIS_HOST=127.0.0.1
ALPENGLOW_REDIS_PORT=6379
ALPENGLOW_CHANNEL=solana_compass_database_fd:alpenglow
