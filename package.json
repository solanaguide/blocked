{
  "name": "solana-block-viz",
  "version": "1.0.0",
  "description": "Real-time 3D visualization of Solana blocks being built",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "ioredis": "^5.8.2",
    "three": "^0.182.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-glsl": "^1.5.5"
  }
}
