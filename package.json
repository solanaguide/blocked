{
  "name": "solana-block-viz",
  "version": "1.0.0",
  "description": "Real-time 3D visualization of Solana blocks being built",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:visual": "npx playwright test --config=tests/visual/playwright.config.ts",
    "test:visual:after": "BASELINE_DIR=after npm run test:visual",
    "test:visual:before": "BASELINE_DIR=before npm run test:visual",
    "test:visual:compare": "bash tests/visual/capture-before-after.sh",
    "test:visual:report": "npx reg-cli tests/visual/baselines/before tests/visual/baselines/after tests/visual/reports/diff --report tests/visual/reports/index.html --json tests/visual/reports/results.json --threshold 0.1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "d3": "^7.8.5",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "three": "^0.160.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "reg-cli": "^0.18.14",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
